{
  "buildCommand": "node scripts/inject-env.mjs",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/stripe-webhook",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}