{
  "buildCommand": "node scripts/inject-env.mjs",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}